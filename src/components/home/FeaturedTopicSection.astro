---
/** Generic prose, card, matrix, and CTA section driven by locale data. */
import { Icon } from 'astro-icon/components';
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';

interface LinkConfig { label: string; href: string; external?: boolean; }
interface CardConfig { title: string; description: string; href?: string; linkLabel?: string; }
interface SectionConfig {
  badge?: string;
  title: string;
  description?: string;
  cards?: CardConfig[];
  matrix?: { caption?: string; headers: string[]; rows: string[][] };
  cta?: LinkConfig;
}
interface Props { section: SectionConfig; locale: Locale; }

const { section, locale } = Astro.props;
const linkHref = (link: { href: string; external?: boolean }) =>
  link.external ? link.href : localizePath(link.href, locale);
---

<section class="section border-t border-border">
  {section.badge && <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{section.badge}</p>}
  <h2 class="mt-1 text-2xl font-bold tracking-tight md:text-3xl">{section.title}</h2>
  {section.description && <p class="mt-3 max-w-4xl leading-7 text-muted-foreground">{section.description}</p>}

  {section.matrix && (
    <div class="mt-6 overflow-x-auto rounded-lg border">
      <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
        {section.matrix.caption && <caption class="sr-only">{section.matrix.caption}</caption>}
        <thead class="bg-muted/60">
          <tr>{section.matrix.headers.map((header) => <th scope="col" class="px-4 py-3 font-semibold">{header}</th>)}</tr>
        </thead>
        <tbody>
          {section.matrix.rows.map((row) => (
            <tr class="border-t border-border">
              {row.map((cell, index) => index === 0
                ? <th scope="row" class="px-4 py-3 font-medium">{cell}</th>
                : <td class="px-4 py-3 text-muted-foreground">{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {section.cards && section.cards.length > 0 && (
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {section.cards.map((card) => (
        <article class="rounded-lg border bg-card p-5">
          <h3 class="text-lg font-semibold">{card.title}</h3>
          <p class="mt-2 leading-7 text-muted-foreground">{card.description}</p>
          {card.href && (
            <a href={localizePath(card.href, locale)} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-foreground hover:text-nav hover:underline">
              {card.linkLabel ?? card.title}
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
            </a>
          )}
        </article>
      ))}
    </div>
  )}

  {section.cta && (
    <a href={linkHref(section.cta)} target={section.cta.external ? '_blank' : undefined} rel={section.cta.external ? 'noopener noreferrer' : undefined} class="mt-6 inline-flex items-center gap-1 font-medium text-foreground hover:text-nav hover:underline">
      {section.cta.label}
      <Icon name="lucide:arrow-right" class="h-4 w-4" />
    </a>
  )}
</section>
