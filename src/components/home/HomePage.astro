---
/** Generic, locale-configured homepage content hub. */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import FeaturedTopicSection from '~/components/home/FeaturedTopicSection.astro';
import FaqSection from '~/components/home/FaqSection.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { detailPath, localizePath } from '~/lib/url';
import { faqPageJsonLd } from '~/lib/seo';

interface Action {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const shared = ui.shared as unknown as Record<string, any>;
const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
const start = home.start ?? { cards: [] };
const featuredSections = Array.isArray(home.featuredSections) ? home.featuredSections : [];
const latest = home.latest ?? {};
const popular = home.popular ?? {};
const faq = home.faq ?? { items: [] };
const closingCta = home.closingCta ?? {};
const recent = await getRecentEntries(locale, {
  category: latest.category,
  limit: latest.limit,
});

function actionHref(action: Action): string {
  return action.external ? action.href : localizePath(action.href, locale);
}

const pageJsonLd = faq.items?.length > 0 ? [...jsonLd, faqPageJsonLd(faq.items)] : jsonLd;
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={pageJsonLd}
>
  <section class="relative flex min-h-[52vh] items-center overflow-hidden border-b border-border md:min-h-[68vh]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-nav/8 via-transparent to-transparent" />
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 select-none text-center text-[18vw] font-black leading-none text-foreground/[0.03] md:text-[14vw]"
    >
      {site.game.name}
    </span>

    <div class="relative mx-auto w-full max-w-7xl px-4 py-16 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{hero.badge}</p>
      <h1 class="mt-3 max-w-4xl bg-gradient-to-r from-foreground to-foreground/60 bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-5xl md:text-6xl lg:text-7xl">
        {hero.title}
      </h1>
      <p class="mt-5 max-w-2xl text-base text-muted-foreground md:text-lg">{hero.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {hero.ctaPrimary && (
          <a href={actionHref(hero.ctaPrimary)} target={hero.ctaPrimary.external ? '_blank' : undefined} rel={hero.ctaPrimary.external ? 'noopener noreferrer' : undefined} class="btn-primary">
            <Icon name="lucide:book-open" class="mr-2 h-4 w-4" />
            {hero.ctaPrimary.label}
          </a>
        )}
        {hero.ctaSecondary && (
          <a href={actionHref(hero.ctaSecondary)} target={hero.ctaSecondary.external ? '_blank' : undefined} rel={hero.ctaSecondary.external ? 'noopener noreferrer' : undefined} class="btn-outline">
            {hero.ctaSecondary.label}
          </a>
        )}
      </div>
    </div>
  </section>

  {hero.videoId && <VideoSection videoId={hero.videoId} title={`${site.game.name} trailer`} />}
  <QuickStart locale={locale} badge={start.badge} title={start.title} cards={start.cards} />

  {featuredSections.map((section: any) => <FeaturedTopicSection section={section} locale={locale} />)}

  {latest.title && (
    <section class="section border-t border-border">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{latest.title}</h2>
        {latest.href && (
          <a href={localizePath(latest.href, locale)} class="shrink-0 text-sm text-foreground hover:text-nav hover:underline">
            {latest.linkLabel ?? shared.browseAll}
          </a>
        )}
      </div>
      {latest.description && <p class="mt-2 max-w-3xl text-muted-foreground">{latest.description}</p>}
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.length === 0 ? (
          <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
        ) : (
          recent.map((entry) => {
            const parsed = parseEntryId(entry.id);
            if (!parsed) return null;
            return (
              <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-5">
                <h3 class="font-semibold leading-snug">{entry.data.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{entry.data.description}</p>
              </a>
            );
          })
        )}
      </div>
    </section>
  )}

  {popular.title && <FeaturedTopicSection section={popular} locale={locale} />}
  {faq.items?.length > 0 && <FaqSection section={faq} locale={locale} />}

  {closingCta.title && (
    <section class="section border-t border-border">
      <div class="rounded-xl border bg-card p-8 text-center md:p-12">
        <h2 class="text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
        <p class="mx-auto mt-2 max-w-2xl text-muted-foreground">{closingCta.description}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {[closingCta.primary, closingCta.secondary].filter(Boolean).map((action: Action, index: number) => (
            <a href={actionHref(action)} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener noreferrer' : undefined} class={index === 0 ? 'btn-primary' : 'btn-outline'}>
              {action.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</LocaleLayout>
