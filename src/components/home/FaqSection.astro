---
/** Generic FAQ section driven by locale data. */
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  headingLevel?: 'h1' | 'h2';
  section: {
    title: string;
    description?: string;
    items: Array<{ question: string; answer: string; link?: { label: string; href: string } }>;
  };
}
const { locale, section, headingLevel = 'h2' } = Astro.props;
---

<section class:list={['section', headingLevel === 'h2' && 'border-t border-border']}>
  {headingLevel === 'h1' ? (
    <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{section.title}</h1>
  ) : (
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{section.title}</h2>
  )}
  {section.description && <p class="mt-2 max-w-3xl text-muted-foreground">{section.description}</p>}
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {section.items.map((item) => (
      <article class="rounded-lg border bg-card p-5">
        <h3 class="text-lg font-semibold leading-snug">{item.question}</h3>
        <p class="mt-2 leading-7 text-muted-foreground">{item.answer}</p>
        {item.link && (
          <a href={localizePath(item.link.href, locale)} class="mt-3 inline-block text-sm font-medium text-foreground hover:text-nav hover:underline">
            {item.link.label}
          </a>
        )}
      </article>
    ))}
  </div>
</section>
